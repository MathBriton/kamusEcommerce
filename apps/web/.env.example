# URL da API usada no servidor (SSR/ISR). No Docker Compose aponta para o serviço "api".
API_URL=http://localhost:5080
# URL pública do site (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:3000
# Mostra os botões de "simular envio/entrega" nos pedidos (a API precisa de Orders__EnableFulfillmentSimulation=true)
ENABLE_FULFILLMENT_SIMULATION=true
